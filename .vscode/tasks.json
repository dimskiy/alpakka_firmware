{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware",
            "type": "shell",
            "command": "DEVICE=${input:firmwareTarget}",
            "args": [
                "make"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "firmwareTarget",
            "type": "pickString",
            "description": "Select firmware target",
            "options": [
                "alpakka_v0",
                "alpakka_v1",
                "dongle",
                "llama"
            ],
            "default": "alpakka_v1"
        }
    ]
}